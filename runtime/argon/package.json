{
  "name": "gemini-argon-bridge",
  "version": "1.0.5",
  "description": "High-performance Model Context Protocol (MCP) server & CLI bridging AI assistants (Antigravity, Claude, Cursor) with Google AI Studio's Gemini 4 Argon reasoning model via real-browser CDP session.",
  "main": "mcp-server.js",
  "bin": {
    "gemini-argon": "./mcp-server.js",
    "ask-argon": "./ask-argon-cli.js"
  },
  "scripts": {
    "start": "node mcp-server.js",
    "login": "node login.js",
    "cli": "node ask-argon-cli.js",
    "test": "node tests/integration.test.js",
    "test:stress": "node tests/stress.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gemini",
    "argon",
    "gemini-4-argon",
    "google-ai-studio",
    "antigravity",
    "reasoning",
    "puppeteer",
    "cdp",
    "browser-bridge"
  ],
  "author": "Aldiyuar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aldiyuar/gemini-argon-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Aldiyuar/gemini-argon-bridge/issues"
  },
  "homepage": "https://github.com/Aldiyuar/gemini-argon-bridge#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "puppeteer-core": "^24.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
